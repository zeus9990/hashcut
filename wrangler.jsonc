{
  "name": "team-tasks",
  "main": "src/worker.js",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "team-tasks-db",
      "database_id": "PASTE-YOUR-DATABASE-ID-HERE"
    }
  ]
}
